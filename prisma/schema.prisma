generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------- AUTH TABLES ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String    @default("traveler") // traveler | vendor | admin
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  reviews Review[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Geo {
  geoId     Int      @id @default(autoincrement())
  parentId  Int?
  parent    Geo?     @relation("GeoTree", fields: [parentId], references: [geoId])
  children  Geo[]    @relation("GeoTree")
  name      String
  type      String
  slug      String
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())

  pois Poi[]

  @@unique([parentId, slug])
  @@index([name])
  @@index([type])
}

model Poi {
  poiId       Int      @id @default(autoincrement())
  geoId       Int
  geo         Geo      @relation(fields: [geoId], references: [geoId], onDelete: Cascade)
  category    String
  name        String
  slug        String
  description String?  @db.Text
  price       Float?
  rating      Float?
  meta        Json?
  createdAt   DateTime @default(now())

  @@unique([geoId, slug])
  @@index([geoId, category])
  @@index([name])

  reviews Review[]
}

model Review {
  reviewId   Int      @id @default(autoincrement())
  userId     String
  poiId      Int
  rating     Int
  text       String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  poi  Poi  @relation(fields: [poiId], references: [poiId], onDelete: Cascade)

  @@unique([userId, poiId])
  @@index([poiId])
  @@index([userId])
}