generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------- AUTH TABLES ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String    @default("traveler") // traveler | vendor | admin
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  reviews Review[]
  wishlist Wishlist[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  id         Int      @id @default(autoincrement())
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Geo {
  geoId     Int      @id @default(autoincrement())
  parentId  Int?
  parent    Geo?     @relation("GeoTree", fields: [parentId], references: [geoId])
  children  Geo[]    @relation("GeoTree")
  name      String
  type      String
  slug      String
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())

  pois Poi[]

  @@unique([parentId, slug])
  @@index([name])
  @@index([type])
}

model Poi {
  poiId       Int      @id @default(autoincrement())
  geoId       Int
  geo         Geo      @relation(fields: [geoId], references: [geoId], onDelete: Cascade)
  category    String
  name        String
  slug        String
  description String?  @db.Text
  price       Float?
  rating      Float?
  meta        Json?
  createdAt   DateTime @default(now())

  @@unique([geoId, slug])
  @@index([geoId, category])
  @@index([name])

  reviews Review[]
  wishlist Wishlist[]
}

model Review {
  reviewId   Int      @id @default(autoincrement())
  userId     String
  poiId      Int
  rating     Int
  text       String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  poi  Poi  @relation(fields: [poiId], references: [poiId], onDelete: Cascade)

  @@unique([userId, poiId])
  @@index([poiId])
  @@index([userId])
}

model Permit {
  id           Int      @id @default(autoincrement())
  parentId     Int?
  parent       Permit?  @relation("PermitTree", fields: [parentId], references: [id])
  children     Permit[] @relation("PermitTree")

  type         String
  name         String
  slug         String
  description  String?  @db.Text
  displayOrder Int      @default(0)

  aliases      Json?
  quickSummary Json?
  costDetails  Json?
  whereToGet   Json?
  documents    Json?
  validity     String?
  notes        String?  @db.Text
  relatedSlugs Json?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([parentId, slug])
  @@index([type])
  @@index([parentId])
}


model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    String
  poiId     Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  poi  Poi  @relation(fields: [poiId], references: [poiId], onDelete: Cascade)

  @@unique([userId, poiId])
  @@index([userId])
  @@index([poiId])
}